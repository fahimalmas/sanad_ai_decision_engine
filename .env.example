# Sanad AI Configuration & Privacy Settings
# -------------------------------------------------------------
# LLM Provider Options:
#   - 'gemini' : Enterprise Google Gemini 2.0 Flash (Fast Cloud API)
#   - 'ollama' : 100% On-Premise Air-Gapped Local LLM (Zero Data Leakage)
#   - 'local'  : Intelligent Local Grounded Synthesizer (No API Key Required)
LLM_PROVIDER=gemini

# Google Gemini Cloud Configuration (Required only if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004

# On-Premises & Air-Gapped Local Configuration (Used if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=gemma2:9b

# Application Settings
APP_ENV=development
PORT=8000
